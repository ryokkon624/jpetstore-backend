# jpetstore-backend ローカル開発用の環境変数テンプレート。
#
# 使い方: このファイルを `.env` としてコピーし、実際の値を設定する。
# `.env` は .gitignore 対象（コミットしないこと）。
#
# AC5/AC-neg1 (SBD-11): 以下はすべてデフォルト値を持たない（未設定だと起動失敗・fail-fast）。
# ソースリポジトリに平文の実値を置かないこと。

# --- DB資格情報（jpetstore-database の docker-compose 既定値。ローカル開発用） ---
DB_USERNAME=jpetstore
DB_PASSWORD=jpetstore

# --- JWT 署名鍵（HS256。最小 32byte。起動時に鍵長を検証する） ---
# ローカル開発用に、下記コマンド等で32byte以上のランダム文字列を生成して設定する。
#   openssl rand -base64 32
JWT_SECRET=please-replace-with-a-random-secret-of-at-least-32-bytes
